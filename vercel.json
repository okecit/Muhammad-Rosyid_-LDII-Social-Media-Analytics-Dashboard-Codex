{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "api/analyze.py"
    },
    {
      "src": "/api/summary",
      "dest": "api/summary.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
